# Copy to .env — src/core/config.py loads it with pydantic-settings.

# Google Gemini (chat + embeddings). Required for real answers; without it the chat
# endpoint falls back to a mock stream.
GOOGLE_API_KEY=
PRIMARY_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=gemini-embedding-001

# Tavily web search (tool: tavily_web_search)
TAVILY_API_KEY=

# Supabase — conversations, folders and agent run state
SUPABASE_URL=
SUPABASE_KEY=

# Qdrant — vector store for the document RAG skill
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

APP_NAME=AI Finance Platform
ENV=development
